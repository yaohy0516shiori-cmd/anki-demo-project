COMPOSE_PROJECT_NAME=memory_flashcards
POSTGRES_DB=memory_flashcards
POSTGRES_USER=memory_flashcards_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://memory_flashcards_user:change_me@localhost:5432/memory_flashcards
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=replace-this-with-a-random-secret-key-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

APP_ENV=development
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60